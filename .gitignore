# Python / uv
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
*.egg-info/

# macOS
.DS_Store

# Production data (PII) — see docs/spec/inms-pipeline.md §8


# CLI run outputs (regenerable — bootstrap/measure/report default paths)
/capa.xlsx
/capa_*.xlsx
/roms/
/reports/

# `split` derived per-Categoria configs (regenerated from categorias.yaml +
# the raw CSV each run — ticket 03, ADR 0002). Extra dot vs. the base
# `inms-<n>.yaml` is the reserved naming convention that makes this glob safe.
configs/*/inms-*.*.yaml

# `pyauditor run`/interactive run-state (ticket "Run orchestrator and resume")
/.pyauditor/

# Per-run CLI log files (bootstrap can land one at the repo root)
/pyauditor-*.log

# Zensical build output (generated by `zensical build`)
/site/

# Contract/payment source docs — not for the public repo or docs site
/docs/termo_de_referencia/
/docs/termo_de_referencia_raw.html
/docs/notas_tecnicas/
/docs/processo_de_pagamento_junho_2026/
.coverage
